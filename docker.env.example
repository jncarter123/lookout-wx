# cp docker.env.example docker.env — this is the file with the secrets in it.

# Where you reach Lookout. Behind a reverse proxy this is the public URL,
# scheme included — the container only ever speaks plain http on 8080, so this
# is what tells the app it is an https site:
#
#   APP_URL=https://lookout.example.com
#
# Get the scheme wrong and the browser blocks the assets as mixed content,
# leaving an unstyled login page.
APP_URL=http://localhost:8000

# Required. NWS asks every client for a descriptive User-Agent with contact
# info, and may block requests without one:
# https://www.weather.gov/documentation/services-web-api
NWS_API_USER_AGENT="lookout-wx (you@example.com)"

# Leave blank and the first run generates one onto the volume. It encrypts
# sessions and cookies; changing it signs everyone out (API tokens still work).
APP_KEY=

# ---------------------------------------------------------------------------
# Real-time dashboard updates (Pusher)
# ---------------------------------------------------------------------------
# `log` runs Lookout without live updates: dashboards show new alerts on the
# next page load. For live updates, create a Pusher Channels app and set:
#
# BROADCAST_CONNECTION=pusher
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1
BROADCAST_CONNECTION=log

# ---------------------------------------------------------------------------
# Optional monitoring
# ---------------------------------------------------------------------------
# SENTRY_LARAVEL_DSN=
NIGHTWATCH_ENABLED=false
# NIGHTWATCH_TOKEN=
